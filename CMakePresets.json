{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC 2026",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/windows-msvc2026",
      "architecture": "x64",
      "toolchainFile": "D:/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_VISUAL_STUDIO_PATH": "D:/tool/visual studio"
      },
      "cacheVariables": {
        "RENDERLAB_BUILD_TESTS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "clang-uml",
      "displayName": "clang-uml compilation database",
      "description": "Generate compile_commands.json for clang-uml without changing the Visual Studio build tree",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-uml",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolchainFile": "D:/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_VISUAL_STUDIO_PATH": "D:/tool/visual studio"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "RENDERLAB_BUILD_TESTS": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
